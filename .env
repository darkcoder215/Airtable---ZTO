AIRTABLE_PAT=your_airtable_personal_access_token_here
NEXT_PUBLIC_APP_URL=http://localhost:3000

# IMPORTANT: replace with a long random string in production. Used to sign
# session tokens (HMAC-SHA256). 32+ characters recommended.
AUTH_SECRET=zto-secret-key-change-in-production-2024

# Initial admin credentials. Used only when no admin exists in app_users
# yet (typically: first deploy). Change ADMIN_PASSWORD on first login.
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-on-first-login
ADMIN_NAME=System Administrator

OPENROUTER_API_KEY=your_openrouter_api_key_here
APIFY_API_TOKEN=your_apify_api_token_here

# Supabase (project: overall-dashboard-ahmed / hbnvbfcwrfanpayxulih)
# - URL is public
# - SERVICE_ROLE_KEY is a server-only secret. NEVER expose to the browser.
# - ANON_KEY is the publishable key, safe to expose
NEXT_PUBLIC_SUPABASE_URL=https://hbnvbfcwrfanpayxulih.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
